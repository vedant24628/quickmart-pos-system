# Quick Mart Environment Configuration Template
# Copy this file to .env and customize for your deployment environment

# Django Secret Key (Generate a secure unique key for production)
SECRET_KEY=your-secure-random-secret-key-here-min-50-characters

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated list of host/domain names)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to embedded SQLite: quickmart.db)
# In production, configure PostgreSQL or MySQL via DATABASE_URL if preferred
# DATABASE_URL=sqlite:///quickmart.db
